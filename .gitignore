.lake/
*.olean
/e2e-out/
_site/
.jekyll-cache/
/parity-out/
# LaTeX build files of examples compiled in place (by an editor)
/examples/**/*.aux
/examples/**/*.log
/examples/**/*.fls
/examples/**/*.fdb_latexmk
/examples/**/*.pdf
# The riemann note's PDF is committed: the site serves it, and building it
# needs Mathlib, which the Pages workflow does not fetch.
!/examples/riemann/paper.pdf
/examples/**/*.synctex.gz
/examples/**/*.out
/examples/*/host/lake-manifest.json
# Papers under papers/ are built in place: the spliced .tex is committed, the rest is not
/papers/**/.imprimatur/
/papers/**/out/
/papers/**/*.aux
/papers/**/*.log
/papers/**/*.fls
/papers/**/*.fdb_latexmk
/papers/**/*.pdf
/papers/**/*.synctex.gz
/papers/**/*.out
