%
% This package defines the markup that imprimatur-splice reads and fills
% (DESIGN.md section 9), and the macros its generated content uses. A document
% compiles with it whether or not imprimatur is installed: it shows the
% content last spliced in. See docs/blocks.md.
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{imprimatur}[2026/10/17 v0.0.0 Lean declarations in LaTeX]

\RequirePackage{amsmath}
% amssymb's symbols, unless a math font package (newtxmath, as acmart loads)
% has defined them already.
\@ifundefined{Bbbk}{\RequirePackage{amssymb}}{}
\RequirePackage{newunicodechar}
% The views that index the document (conventions, vocabulary, provenance)
% are long tables.
\RequirePackage{longtable}
\RequirePackage{needspace}
\RequirePackage{array}

% ---------------------------------------------------------------------------
% Markup (DESIGN 9.1). Options are read with l3keys; unknown ones are ignored,
% so blocks can carry options that later versions use.
% A wrap that ends like center (\@endpetrue) raises \ifimprimatur@endpe too:
% each enclosing environment's \end consumes LaTeX's flag, so leanblock and
% an alias raise it again, and text after the block is not indented.
\newif\ifimprimatur@endpe
\ExplSyntaxOn
\tl_new:N \l__imprimatur_wrap_tl
\tl_new:N \l__imprimatur_label_tl
\keys_define:nn { imprimatur }
  {
    wrap    .tl_set:N = \l__imprimatur_wrap_tl ,
    label   .tl_set:N = \l__imprimatur_label_tl ,
    unknown .code:n   = { }
  }

% \begin{leanblock}[options]{key}{title} ... \end{leanblock}
% With wrap=ENV, the content is set in \begin{ENV}[title]; label=L adds \label{L}.
\NewDocumentEnvironment { leanblock } { O{} m m }
  {
    \tl_clear:N \l__imprimatur_wrap_tl
    \tl_clear:N \l__imprimatur_label_tl
    \keys_set:nn { imprimatur } { #1 }
    \global\imprimatur@endpefalse
    \par
    \tl_if_empty:NF \l__imprimatur_wrap_tl
      {
        \tl_if_blank:nTF { #3 }
          { \exp_args:NV \begin \l__imprimatur_wrap_tl }
          { \exp_args:NV \begin \l__imprimatur_wrap_tl [ #3 ] }
      }
    \tl_if_empty:NF \l__imprimatur_label_tl
      { \exp_args:NV \label \l__imprimatur_label_tl }
  }
  {
    \tl_if_empty:NF \l__imprimatur_wrap_tl
      { \exp_args:NV \end \l__imprimatur_wrap_tl }
    \par
    \ifimprimatur@endpe \@endpetrue \fi
  }

% \leanblockalias{NAME}{WRAP}: define environment NAME as a leanblock that
% wraps its content in WRAP (which may be empty), for [aliases] entries.
\NewDocumentCommand \leanblockalias { m m }
  {
    \NewDocumentEnvironment { #1 } { O{} m m }
      { \begin { leanblock } [ wrap = { #2 } , ##1 ] { ##2 } { ##3 } }
      { \end { leanblock } \ifimprimatur@endpe \global\imprimatur@endpefalse \@endpetrue \fi }
  }
\ExplSyntaxOff

% \leaninline[options]{key}{generated text}
\NewDocumentCommand\leaninline{O{} m m}{#3}
% \leanref[options]{key}{generated location}
\NewDocumentCommand\leanref{O{} m m}{#3}
% \leancheck[options]{key, ...}: ties prose to Lean; prints nothing. It removes
% the space before it, so both "checked \leancheck{k} against" and
% "holds \leancheck{k}." read naturally.
\NewDocumentCommand\leancheck{O{} m}{\unskip}
% \leanindex: the table of every key used (generated from v0.5).
\NewDocumentCommand\leanindex{}{}
% \leanslot{id}{text}: text that belongs to the authors.
\NewDocumentCommand\leanslot{m m}{#2}
% \leanmetasource{location}: filled by the splicer according to the profile;
% prints nothing when the profile gives no location.
\ExplSyntaxOn
\NewDocumentCommand \leanmetasource { m } { \tl_if_blank:nF { #1 } { Lean:~#1.~ } }
\ExplSyntaxOff

% ---------------------------------------------------------------------------
% The lean view (DESIGN 7.3): semantic macros for tokens, in the manner of
% agda.sty. Redefine any of them to change the style.
% \LeanCode works inline (in \leaninline) and in blocks; \LeanNewline breaks
% the line without ending the paragraph.
% In the monospace font, the escaped specials are the font's own ASCII
% characters (in OT1, T1 and TU alike), not symbols borrowed from maths fonts.
\newcommand\LeanCodeFont{\ttfamily\footnotesize\upshape\mdseries\frenchspacing}
\newcommand\LeanCodeSpecials{%
  \def\_{\char95\relax}\def\{{\char123\relax}\def\}{\char125\relax}%
  \def\textbackslash{\char92\relax}\def\textasciitilde{\char126\relax}%
  \def\textasciicircum{\char94\relax}}
\newcommand\LeanCode[1]{\begingroup\LeanCodeFont\LeanCodeSpecials #1\endgroup}
\newcommand\LeanNewline{\newline}
\newcommand\LeanIndent[1]{\hspace*{#1\fontcharwd\font`m}}
\newcommand\LeanSpace[1]{\hspace*{#1\fontcharwd\font`m}}
\newcommand\LeanKeyword[1]{\textbf{#1}}
\newcommand\LeanSort[1]{\textbf{#1}}
\newcommand\LeanConst[1]{#1}
\newcommand\LeanBound[1]{\textsl{#1}}
\newcommand\LeanNumber[1]{#1}
\newcommand\LeanString[1]{#1}
\newcommand\LeanCodeInline[1]{{\LeanCodeFont\LeanCodeSpecials #1}}

% The meta view: source location, axioms, sorry status, docstring.
\newcommand\LeanSorryFree{sorry-free}
\newcommand\LeanUsesSorry{\textbf{uses sorry}}
\newcommand\LeanMeta[4]{{\small #1Axioms: \ifx\relax#2\relax none\else #2\fi;
  #3.\ifx\relax#4\relax\else\space #4\fi}}

% ---------------------------------------------------------------------------
% The math and prose views (DESIGN 7.3). \LeanMath sets a formula; when it is
% too wide, \LeanBreak separates its lines, which are set as the rows of a
% left-aligned array, the later ones indented.
\newcommand\LeanMath[1]{\ensuremath{\begin{array}[t]{@{}l@{}}#1\end{array}}}
\newcommand\LeanBreak{\\\quad}
% A constant with no notation, and Lean's own rendering of what has none.
\newcommand\LeanMathConst[1]{\mathsf{#1}}
\newcommand\LeanMathCode[1]{\text{\LeanCode{#1}}}
% Prose, and the label of a hypothesis in it.
\newcommand\LeanProse[1]{#1}
\newcommand\LeanHyp[1]{(\textup{#1})}
% \leanhypref{key}{h}: refers to hypothesis h of the result with key `key`, as
% its prose view labels it; the prose view labels only hypotheses referred to.
\NewDocumentCommand\leanhypref{m m}{\LeanHyp{#2}}

% ---------------------------------------------------------------------------
% The grammar view (DESIGN 7.3): a production per inductive type, one row per
% constructor, with the author-owned description in the last column.
% The descriptions, in text mode, wrap: the last column is a paragraph of
% \leangrammarwidth.
\newcommand\leangrammarwidth{.42\linewidth}
\newenvironment{LeanGrammar}{\[\begin{array}{@{}r@{\;}c@{\;}l@{\qquad}>{\raggedright\arraybackslash}p{\leangrammarwidth}@{}}}{\end{array}\]}

% Displays (the `clauses` and `grammar|display` views): rows of a formula and
% its description, set in LeanDisplay as one paragraph per row. A long
% formula breaks after an operator or a comma; the description sits flush
% right on the formula's line if it fits, else on the next, and one wider
% than half the line is wrapped. A paper may redefine \deq (≜) and \defeqq
% (::=), and the rows' macros.
\providecommand\deq{\triangleq}
\providecommand\defeqq{\mathrel{::=}}
\newcommand\imprimatur@bra{\hbox to \linewidth{\vrule width0.3mm height 1.8mm depth-0.3mm
  \leaders\hrule height1.8mm depth-1.5mm\hfill\vrule width0.3mm height 1.8mm depth-0.3mm}}
\newcommand\imprimatur@ket{\hbox to \linewidth{\vrule width0.3mm height1.5mm
  \leaders\hrule height0.3mm\hfill\vrule width0.3mm height1.5mm}}
\newcommand\imprimatur@breakcommas{%
  \begingroup\lccode`\~=`\,\lowercase{\endgroup\def~}{\mathchar"613B\penalty300\relax}%
  \mathcode`\,="8000\relax}
\newenvironment{LeanDisplay}{%
  \par\begingroup\parindent0pt\parskip0pt\emergencystretch3em
  \rightskip0pt plus 4em\relax
  \imprimatur@breakcommas
  \let\\\imprimatur@row}%
  {\par\endgroup}
% A page break between rows is discouraged, not forbidden: a long display
% may still break.
\newcommand\imprimatur@row{\@ifnextchar[{\imprimatur@rowskip}{\par\penalty2000\relax}}
\def\imprimatur@rowskip[#1]{\par\penalty2000\vskip#1\relax}
% \imprimatur@line{indent}{formula}{description}
\newcommand\imprimatur@line[3]{%
  \hangindent2.5em\hangafter1\leavevmode\kern.1em\hspace*{#1}$#2$%
  \setbox0\hbox{#3}\ifdim\wd0>0pt
    \ifdim\wd0>.5\linewidth
      \setbox0\vtop{\hsize.5\linewidth\raggedleft\noindent#3}\fi
    \unskip\nobreak\hfil\penalty50\hskip1.5em\hbox{}\nobreak\hfil\box0
    {\parfillskip0pt\par}\else\par\fi}
\newcommand\LeanClause[2]{\imprimatur@line{0pt}{#1}{#2}}
\newcommand\LeanCategory[2]{\imprimatur@line{0pt}{#1\;\defeqq}{#2}}
\newcommand\LeanEntry[2]{\imprimatur@line{1.5em}{#1}{#2}}
% A titled box around a display or a block of rules: the wrapping
% environment of an alias (wrap = "LeanDisplayBox"), which passes the block's
% title as its optional argument. Text that follows without a blank line
% continues the paragraph, unindented, as after center.
\newenvironment{LeanDisplayBox}[1][]{%
  \par\vskip\smallskipamount\needspace{4\baselineskip}%
  \noindent{\raggedright\textbf{#1}\par}\nopagebreak\vskip-.6ex
  \noindent\imprimatur@bra\par\nopagebreak\vskip-.4ex}%
  {\par\nopagebreak\vskip-.6ex\noindent\imprimatur@ket\par\vskip\smallskipamount\global\imprimatur@endpetrue\@endpetrue}
\newenvironment{LeanRulesBox}[1][]{%
  \par\medskip\needspace{4\baselineskip}%
  \noindent{\raggedright\textbf{#1}\par}\nopagebreak\vspace{-.8ex}%
  \noindent\imprimatur@bra\nopagebreak
  \setlength{\abovedisplayskip}{2pt}\setlength{\abovedisplayshortskip}{2pt}%
  \setlength{\belowdisplayskip}{2pt}\setlength{\belowdisplayshortskip}{2pt}}%
  {\par\nopagebreak\vspace{-.8ex}\noindent\imprimatur@ket\medskip\global\imprimatur@endpetrue\@endpetrue}
\newcommand\LeanProduction[4]{#1 & ::= & #3 & #4\\}
\newcommand\LeanAlternative[2]{ & \mid & #1 & #2\\}
% A structure: its name and description across the whole width, then its
% fields.
\newcommand\LeanStructure[2]{\multicolumn{4}{@{}p{\linewidth}@{}}{$#1$\quad #2}\\}
\newcommand\LeanField[3]{ & & \mathit{#1} : #2 & #3\\}

